# Copy to .env and fill in. Only MONGODB_* and JWTTOKENSECRET predate the
# notification platform; everything below activates a sender when present
# and stays dormant (logging) when absent.

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE=
JWTTOKENSECRET=
# NODE_ENV=production   # required for Secure + SameSite=None session cookies
# Optional dedicated key for HMAC-hashing KYC document numbers.
KYC_HASH_SECRET=
# Optional pilot override for the growth-campaign minimum budget (NGN).
CAMPAIGN_MIN_BUDGET_NGN=20000
# Public acquisition site used to build campaign tracking links.
PUBLIC_SITE_URL=https://marketspase.com
# Day-7 activation mentor bonus amount.
ACTIVATION_MENTOR_BONUS_NGN=1000
# Legacy password var (kept for backward compat — EMAIL_PASS wins when set).
EMAILPASS=
PORT=8080
SUPPORT_OWNER_EMAILS=
# Public contact form recipients (comma-separated). Falls back to
# SUPPORT_OWNER_EMAILS, then contacts@marketspase.com.
CONTACT_ALERT_EMAILS=
# Extra web origins for CORS (comma-separated) — new subdomains go here
# without a code change, e.g. the client app's subdomain:
# EXTRA_CORS_ORIGINS=https://join.c21fg.online
EXTRA_CORS_ORIGINS=

# --- Email Service (SMTP, all platform mail flows through it) -------------
# Port 465 + EMAIL_SECURE=true is implicit TLS. The SMTP certificate covers
# marketspase.com; STARTTLS on port 587 presents the server hostname cert.
# Auth was verified on marketspase.com:465 with noreply@marketspase.com.
EMAIL_HOST=marketspase.com
# Optional SMTP overrides. Defaults: port 465 + implicit TLS.
# EMAIL_PORT=465
# EMAIL_SECURE=true
EMAIL_USER=noreply@marketspase.com
EMAIL_PASS=
EMAIL_FROM_NAME=MarketSpase
EMAIL_FROM_EMAIL=noreply@marketspase.com

# Public web origin used for auth/verification links. Local dev: http://localhost:4200.
FRONTEND_URL=

# Public web origin (push-click targets + email links). Empty = relative paths.
APP_BASE_URL=https://marketspase.com
# Public client site used in subscription confirmation/unsubscribe pages.
PUBLIC_SITE_URL=https://marketspase.com
# Optional explicit API origin for subscription links (derived from the request when empty).
API_BASE_URL=
# Inboxes alerted when a subscriber confirms (comma-separated). Falls back to
# SUPPORT_OWNER_EMAILS, then contacts@marketspase.com.
EMAIL_SUBSCRIPTION_ALERTS=

# --- Web push (VAPID). Generate once: npx web-push generate-vapid-keys ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@c21fg.online

# --- SMS via BulkSMSNigeria (verified 2026-09-17, api/v2) ------------------
# disabled (default): sends are logged, never spent.
# http: POSTs {<TO_FIELD>, <MESSAGE_FIELD>, from, ...EXTRA} as JSON, which
# maps 1:1 onto POST https://www.bulksmsnigeria.com/api/v2/sms
# ({from, to, body}). Bearer token from their dashboard; NEVER commit it.
# Sender ID MUST be pre-approved on their dashboard (C21FG is approved).
SMS_PROVIDER=disabled
SMS_HTTP_URL=https://www.bulksmsnigeria.com/api/v2/sms
SMS_HTTP_METHOD=POST
SMS_HTTP_HEADERS={"Authorization":"Bearer <bulksmsnigeria-token>","Accept":"application/json"}
SMS_HTTP_TO_FIELD=to
SMS_HTTP_MESSAGE_FIELD=body
SMS_HTTP_EXTRA={"gateway":"direct-refund"}
SMS_SENDER_ID=C21FG
SMS_HTTP_TIMEOUT_MS=15000
# Partner price per SMS recipient per 160-char page (₦). Single source of
# truth lives in code (outreach Outreach.entity); this env overrides it.
# Must stay above the gateway unit cost (≈₦6.49): 10 ≈ 35% gross margin.
SMS_PRICE_PER_PAGE=10

# --- Outreach ------------------------------------------------------------
# Shared secret providers include when POSTing delivery reports to
# POST /v1/outreach/sms/delivery (as ?token= or {token}). Empty = accepted
# without a check (dev-friendly); set it in production.
SMS_CALLBACK_TOKEN=

# --- Ora AI assistant (DeepSeek) ------------------------------------------
# Empty key = /v1/ora/chat answers 503 "not configured". NEVER commit a key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=800
DEEPSEEK_TIMEOUT_MS=30000
ORA_DAILY_LIMIT=50

# --- Cloudinary (profile photos) ------------------------------------------
# SERVER-SIDE ONLY. Never commit real values, never expose in frontend code.
# Standard URL form (preferred): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# ...or individual vars (override the URL parts when set):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=diamond-projects

# --- Paystack (bank directory + account-name resolution) -------------------
# Server-side only. Used by GET /v1/billing/banks and /resolve-account;
# the browser never calls api.paystack.co directly.
PAYSTACKTOKEN=

# --- Opay deposits (wallet top-up, Express Checkout Cashier) ---------------
# Empty = deposit init answers 503 "not configured". Test keys are safe to
# use in staging but treat the private key like a password everywhere.
# NEVER commit real values — set them in the host dashboard / local .env.
# MerchantId comes from the Opay dashboard (same page as the API keys).
OPAY_TEST_BASE=https://testapi.opaycheckout.com
OPAY_TEST_PUBLIC_KEY=
OPAY_TEST_PRIVATE_KEY=
OPAY_MERCHANT_ID=
# OPAY_MODE=test (default) uses the OPAY_TEST_* keys above; set to live for production.
# Live values (only when going live — keep test + live separate):
OPAY_LIVE_BASE=https://liveapi.opaycheckout.com
OPAY_LIVE_PUBLIC_KEY=
OPAY_LIVE_PRIVATE_KEY=
# Where Opay sends the server-to-server payment result. Must be the public
# backend URL; whitelist it in the Opay dashboard if it asks for one.
OPAY_CALLBACK_URL=https://c21fg-f054fmrs.b4a.run/v1/billing/deposit/callback
# Where members land after paying (frontend confirms the credit there).
OPAY_RETURN_URL=https://marketspase.com/dashboard/wallet/deposit/result
# Manual-transfer receiving accounts (JSON). Shown on the deposit page and
# enforced server-side (claims must name one of these). Rotate numbers here.
MANUAL_DEPOSIT_ACCOUNTS=[{"bank":"Opay","number":"6102514335","name":"ASYNC SOLUTIONS LTD"},{"bank":"Opay","number":"6102513801","name":"ASYNC SOLUTIONS LTD"}]
# Extra inboxes alerted on manual deposit claims (comma-separated, additive
# to role-admins). Empty = role-admins only.
DEPOSIT_ALERT_EMAILS=

# --- Lead pool (Buy Prospect) -------------------------------------------------
# Max paid claims per partner per calendar day (default 100).
LEAD_DAILY_LIMIT=100
# Hours a claimed lead must show activity before auto-return (default 48).
LEAD_CLAIM_HOURS=48
# Days a pool-claimed lead can be returned for refund (default 7).
LEAD_RELEASE_DAYS=7

# --- Dormant nudge ------------------------------------------------------------
# Days of silence before the one-time "we miss you" email fires (default 3).
DORMANT_NUDGE_DAYS=3
